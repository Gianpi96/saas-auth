# .env.test
# ──────────
# Variabili d'ambiente per i test di integrazione locali.
# Copiare in .env.test e NON committare nel git se contiene dati reali.
#
# Uso:
#   $env:TEST_DATABASE_URL="postgresql+asyncpg://postgres:TUA_PASSWORD@localhost:5432/saas_auth_test"
#   pytest tests/test_integration.py -v

TEST_DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/saas_auth_test
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_auth_test
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/saas_auth_test
JWT_SECRET_KEY=test-secret-key-locale-non-usare-in-produzione-assolutamente
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
GROQ_API_KEY=test-not-real-bypass-in-integration
DEBUG=false
